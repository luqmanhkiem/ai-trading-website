DATABASE_URL=sqlite:///./aurum.db
# For PostgreSQL instead (start the root compose service):
# DATABASE_URL=postgresql+psycopg://aurum:local_dev_only@127.0.0.1:5432/aurum
DATA_MODE=simulated
TICK_SECONDS=1
SIMULATION_STEP_SECONDS=15
SIMULATION_SEED=42
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Live integration is an unimplemented provider boundary. A key alone does not enable it.
BROKER_API_KEY=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional read-only Valetax MT5 bridge (see mt5/SETUP.md).
# Set DATA_MODE=mt5 only after configuring the token and exact Market Watch symbol.
MT5_BRIDGE_TOKEN=
MT5_SYMBOL=XAUUSD.vx
MT5_STALE_SECONDS=15

# Preferred direct OANDA API feed: no desktop terminal required.
# Set DATA_MODE=oanda. Leave token/account blank until added privately.
OANDA_ENVIRONMENT=practice
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_INSTRUMENT=XAU_USD
OANDA_POLL_SECONDS=2
OANDA_STALE_SECONDS=15

# Official weekly export; no account/key needed. Refreshed at most hourly by default.
CALENDAR_PROVIDER=forex_factory
CALENDAR_REFRESH_SECONDS=3600
